PORT=5001
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-2.5-flash
# In production set this to your exact frontend origin, e.g. https://jansetu.example.com
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Supabase — get from: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_ANON_KEY=replace_with_anon_key

# Redis — get from: Upstash.com (free tier) or leave blank for in-memory rate limiting
REDIS_URL=redis://default:password@host:port
