# Backend API Base URL (leave empty when deploying with Vercel rewrites or locally; set to Render URL e.g. https://janseva-cjuq.onrender.com for direct cross-origin calls)
VITE_API_BASE_URL=https://janseva-cjuq.onrender.com

# Supabase public credentials (optional)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_anon_public_key

